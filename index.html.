body{font-family:sans-serif;background:#f4f4f5;margin:0;padding:15px;padding-bottom:90px;}
h2{text-align:center;}
.products{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.card{background:#fff;border-radius:10px;padding:10px;}
.card img{width:100%;height:100px;object-fit:cover;border-radius:6px;}
.title{font-weight:bold;font-size:14px;margin:5px 0;}
.price{color:green;font-weight:bold;margin-bottom:8px;}
.btn{background:#2481cc;color:#fff;border:none;padding:8px;border-radius:6px;width:100%;font-weight:bold;}

🛒 Каталог товаров

const tg = window.Telegram.WebApp; tg.expand();
const products = [
  {id:1, name:"Товар 1", price:500, img:"https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=300"},
  {id:2, name:"Товар 2", price:1200, img:"https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=300"},
  {id:3, name:"Товар 3", price:850, img:"https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=300"},
  {id:4, name:"Товар 4", price:2100, img:"https://images.unsplash.com/photo-1583394838336-acd977736f90?w=300"}
];
let cart = [];
const catalog = document.getElementById('catalog');
products.forEach(p => {
  catalog.innerHTML += `<div class="card"><img src="${p.img}"><div class="title">${p.name}</div><div class="price">${p.price} ₽</div><button class="btn" onclick="add(${p.id})">В корзину</button></div>`;
});
function add(id){
  cart.push(products.find(p=>p.id===id));
  let total = cart.reduce((s,i)=>s+i.price,0);
  tg.MainButton.setText(`Оформить заказ (${total} ₽)`).show();
}
tg.MainButton.onClick(()=>{
  tg.sendData(JSON.stringify({items:cart.map(i=>i.name)}));
});